# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=go_boilerplate
DB_SSLMODE=disable

# Server Configuration
PORT=8080
GIN_MODE=debug
LOG_LEVEL=info

# Nosql Database
MONGO_HOST = localhost
MONGO_PORT = 27017
MONGO_USERNAME = 
MONGO_PASSWORD = 
MONGO_DB = gopeople

GOPEOPLE_CLIENT_ID=
GOPEOPLE_CLIENT_SECRET=
GOPEOPLE_API_URL=https://staging.peopleapi.tamtam.pro/

# Redis Configuration (for Caching, Queues, OTP Store)
REDIS_HOST = localhost
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_DB = 0 # Default DB for general use
REDIS_OTP_DB = 1 # Separate DB for OTPs (optional, adjust if needed)
REDIS_QUEUE_KEY = go_init_queue # Example queue key
REDIS_STREAM_NAME = go_init_events # Redis stream name for event publishing
REDIS_CONSUMER_GROUP = go_init_consumers # Consumer group name
REDIS_CONSUMER_NAME = consumer_1 # Consumer name
REDIS_OTP_EXPIRY_SECONDS = 300 # e.g., 5 minutes

# JWT Configuration (Validation Only - External Service)
# This service validates JWTs signed by gopeople using the public key
# Get the public key from gopeople and place it in ./keys/public.pem
# NEVER use the private key in this service!
JWT_PUBLIC_KEY_PATH=./keys/public.pem

