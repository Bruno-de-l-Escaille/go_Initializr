# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=go_boilerplate
DB_SSLMODE=disable

# Server Configuration
PORT=8080
GIN_MODE=debug
LOG_LEVEL=info

# JWT Configuration (Validation Only - External Service)
# This service validates JWTs signed by gopeople using the public key
# Get the public key from gopeople and place it in ./keys/public.pem
# NEVER use the private key in this service!
JWT_PUBLIC_KEY_PATH=./keys/public.pem